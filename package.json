{
  "name": "mecards",
  "version": "0.0.1",
  "description": "Store membership and points cards persistently. This PWA must be installed for persistent storage to be allowed by the device.",
  "keywords": [
    "barcodes",
    "persistent storage",
    "PWA",
    "mobile web app",
    "membership cards"
  ],
  "homepage": "https://github.com/JakobJingleheimer/mecards#readme",
  "bugs": {
    "url": "https://github.com/JakobJingleheimer/mecards/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JakobJingleheimer/mecards.git"
  },
  "license": "MIT",
  "author": "JakobJingleheimer",
  "type": "module",
  "main": "./src/main.tsx",
  "scripts": {
    "build": "rm -rf ./dist && node ./build/prod.ts",
    "build:prod": "NODE_ENV=production node --run build",
    "dev": "NODE_ENV=development PORT=8443 rm -rf ./dist && node ./build/dev.ts",
    "start": "node --run build && node --run serve",
    "start:prod": "node --run build:prod && node --run serve",
    "serve": "PORT=8443 http-server -S -C ./cert.pem -K key.pem ./dist",
    "test:unit": "node --experimental-config-file=./node.config.test.json --test",
    "test:units": "node --run test:unit -- './build/**/*.spec.ts' './src/**/*.spec.ts'",
    "types:check": "tsc --build --noEmit"
  },
  "dependencies": {
    "@tabler/icons": "^3.46.0",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.1",
    "kelpui": "^1.6.4",
    "lodash.debounce": "^4.0.8",
    "nanoid": "^5.1.6",
    "preact": "^10.27.2",
    "preact-iso": "^2.11.0",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  },
  "devDependencies": {
    "@jedmao/location": "^3.0.0",
    "@testing-library/preact": "^3.2.4",
    "@types/ejs": "^3.1.5",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/serviceworker": "^0.0.199",
    "@types/web-app-manifest": "^1.0.9",
    "ejs": "^3.1.10",
    "esbuild": "^0.25.12",
    "esbuild-plugin-svgr": "^3.1.1",
    "mime-types": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "http-server": "^14.1.1"
  }
}
